include ../misc/logging.ninja

rule cc
    command = $cc $cflags -MMD -MF $out.d -c $in -o $out
    depfile = $out.d
    deps = gcc
    description = ${BOLD}${GREEN}Compiling${RESET} $in ${DIM}${version}${RESET}

rule link
    command = $cc -fuse-ld=$ld $ldflags $in -o $out
    description = ${BOLD}${CYAN}Linking${RESET} $out ${DIM}(OpenCraft's advanced early Ninja access)${RESET}
