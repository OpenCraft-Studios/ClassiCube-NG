{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"eval \"$(make env)\" && make"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "make",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Clangd: Regenerate",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"eval \"$(make env)\" && make .clangd"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Rebuild",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Clean",
				"Clangd: Regenerate",
				"Build"
			],
			"problemMatcher": []
		}
	]
}